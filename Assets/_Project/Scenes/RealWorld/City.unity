  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a9d0e43275ddd24c9e67f51d96ada82, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SwordArt.World.InfoPoint
  promptText: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0430\u0444\u0438\u0448\u0443"
  title: "\u0410\u0444\u0438\u0448\u0430"
  lines:
  - "GUN GALE ONLINE \u2014 3-\u0439 \u0442\u0443\u0440\u043D\u0438\u0440 BULLET
    OF BULLETS!\n\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F
    \u0431\u0438\u0442\u0432\u0430: \u0432\u044B\u0436\u0438\u0432\u0430\u0435\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D. \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F
    \u043E\u0442\u043A\u0440\u044B\u0442\u0430 \u0432 \u043B\u043E\u0431\u0431\u0438
    \u0442\u0443\u0440\u043D\u0438\u0440\u0430."
  - "\u041F\u0440\u0438\u0437\u043E\u0432\u043E\u0439 \u0444\u043E\u043D\u0434: 500
    \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044E,
    \u043D\u0430\u0433\u0440\u0430\u0434\u044B \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
    \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435.\n\u041E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435:
    AmuSphere / FullDive \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0435
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430."
