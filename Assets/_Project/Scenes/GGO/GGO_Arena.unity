  title: "\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440 BoB"
  lines:
  - "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
    \u0432 \u043B\u043E\u0431\u0431\u0438 Bullet of Bullets! \u041B\u041A\u041C \u2014
    \u043E\u0433\u043E\u043D\u044C, \u041F\u041A\u041C \u2014 \u043F\u0440\u0438\u0446\u0435\u043B,
    R \u2014 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430,
    1/2/3 \u0438 \u043A\u043E\u043B\u0435\u0441\u043E \u2014 \u0441\u043C\u0435\u043D\u0430
    \u043E\u0440\u0443\u0436\u0438\u044F, H \u2014 \u0430\u043F\u0442\u0435\u0447\u043A\u0430."
  - "\u041A\u0440\u0443\u0433 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u044D\u043A\u0440\u0430\u043D\u0430
    \u2014 \xABbullet circle\xBB: \u043F\u0443\u043B\u044F \u043F\u043E\u043F\u0430\u0434\u0451\u0442
    \u0432\u043D\u0443\u0442\u0440\u044C \u043D\u0435\u0433\u043E. \u041E\u043D \u0441\u0443\u0436\u0430\u0435\u0442\u0441\u044F,
    \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0441\u0442\u043E\u0438\u0442\u0435
    \u0438 \u0446\u0435\u043B\u0438\u0442\u0435\u0441\u044C."
  - "\u041A\u0440\u0430\u0441\u043D\u0430\u044F \u043B\u0438\u043D\u0438\u044F \u2014
    \xABbullet line\xBB \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430:
    \u0442\u0430\u043A \u043E\u043D \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0435\u0442
    \u0432\u0430\u0441 \u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435. \u0423\u0445\u043E\u0434\u0438\u0442\u0435
    \u0441 \u043B\u0438\u043D\u0438\u0438!"
  - "\u041A\u0443\u043F\u043E\u043B \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439
    \u0437\u043E\u043D\u044B \u0441\u0436\u0438\u043C\u0430\u0435\u0442\u0441\u044F.
    \u0421\u043D\u0430\u0440\u0443\u0436\u0438 \u0432\u044B \u0442\u0435\u0440\u044F\u0435\u0442\u0435
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0439 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
    500 \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432."
