--- !u!114 &317349411
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 317349410}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a9d0e43275ddd24c9e67f51d96ada82, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SwordArt.World.InfoPoint
  promptText: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043D\u043E\u0432\u043E\u0441\u0442\u0438
    \u043D\u0430 \u041F\u041A"
  title: "MMO Stream \u2014 \u043D\u043E\u0432\u043E\u0441\u0442\u0438"
  lines:
  - "MMO STREAM: \xAB\u0422\u0440\u0435\u0442\u0438\u0439 \u0442\u0443\u0440\u043D\u0438\u0440
    Bullet of Bullets \u0432 Gun Gale Online \u0441\u0442\u0430\u0440\u0442\u0443\u0435\u0442
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F! \u0421\u0430\u043C\u044B\u0435 \u043C\u0435\u0442\u043A\u0438\u0435
    \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043C\u0438\u0440\u0430 \u0441\u043E\u0439\u0434\u0443\u0442\u0441\u044F \u0432
    \u043F\u0443\u0441\u0442\u043E\u0448\u0430\u0445\xBB."
  - "\xAB\u0421\u043E\u0432\u0435\u0442 \u043D\u043E\u0432\u0438\u0447\u043A\u0430\u043C:
    \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u043B\u0438\u043D\u0438\u044F \u043F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u044F
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430 \u2014 \u0432\u0430\u0448
    \u043B\u0443\u0447\u0448\u0438\u0439 \u0434\u0440\u0443\u0433. \u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C,
    \u043A\u043E\u0433\u0434\u0430 \u0432\u0438\u0434\u0438\u0442\u0435 \u0435\u0451\xBB."
  - "\u041B\u0438\u0447\u043D\u044B\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F:
    \xAB\u041A\u0443\u043F\u0438 \u0445\u043E\u0442\u044F \u0431\u044B \u0430\u0432\u0442\u043E\u043C\u0430\u0442
    \u043F\u0435\u0440\u0435\u0434 \u0442\u0443\u0440\u043D\u0438\u0440\u043E\u043C.
    \u0421 \u043E\u0434\u043D\u0438\u043C \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u043C
    \u0431\u0443\u0434\u0435\u0442 \u0442\u044F\u0436\u0435\u043B\u043E. \u2014 \u0414\u0437\u044E\u043D\xBB"
