  m_Script: {fileID: 11500000, guid: a256809e7fe07f34996aabac26a8f50f, type: 3}
  m_Name: NPC_Ayano
  m_EditorClassIdentifier: Assembly-CSharp::SwordArt.NPC.NPCData
  displayName: "\u0410\u044F\u043D\u043E"
  role: "\u0421\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430"
  shirtColor: {r: 0.85, g: 0.45, b: 0.55, a: 1}
  pantsColor: {r: 0.2, g: 0.22, b: 0.35, a: 1}
  hairColor: {r: 0.35, g: 0.2, b: 0.12, a: 1}
  skinColor: {r: 0.95, g: 0.8, b: 0.68, a: 1}
  walkSpeed: 1.3
  dialogues:
  - lines:
    - "\u041F\u0440\u0438\u0432\u0435\u0442! \u0422\u044B \u0442\u043E\u0436\u0435
      \u0438\u0433\u0440\u0430\u0435\u0448\u044C \u0432 VRMMO? \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430
      \u0441 NerveGear \u0432\u0441\u0451 \u0441\u0442\u0430\u043B\u043E \u0433\u043E\u0440\u0430\u0437\u0434\u043E
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435."
    - "AmuSphere \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0438\u0433\u043D\u0430\u043B\u044B, \u0442\u0430\u043A \u0447\u0442\u043E
      \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.
      \u041F\u0440\u043E\u0441\u0442\u043E \u043E\u0447\u0435\u043D\u044C, \u043E\u0447\u0435\u043D\u044C
      \u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E."
  - lines:
    - "\u0421\u043B\u044B\u0448\u0430\u043B\u0430 \u043F\u0440\u043E Bullet of Bullets?
      \u0422\u0443\u0440\u043D\u0438\u0440 \u0432 Gun Gale Online, \u0433\u0434\u0435
      \u0432\u044B\u0436\u0438\u0432\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0434\u0438\u043D."
    - "\u041C\u043E\u0439 \u0431\u0440\u0430\u0442 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u0442\u0430\u043C \u0432\u0438\u0434\u043D\u043E \u043A\u0440\u0430\u0441\u043D\u0443\u044E
      \u043B\u0438\u043D\u0438\u044E, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043F\u043E\u043B\u0435\u0442\u0438\u0442 \u043F\u0443\u043B\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430.
      \u0416\u0443\u0442\u043A\u043E, \u043F\u0440\u0430\u0432\u0434\u0430?"
