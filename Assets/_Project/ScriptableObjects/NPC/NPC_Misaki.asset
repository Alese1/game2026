  m_Script: {fileID: 11500000, guid: a256809e7fe07f34996aabac26a8f50f, type: 3}
  m_Name: NPC_Misaki
  m_EditorClassIdentifier: Assembly-CSharp::SwordArt.NPC.NPCData
  displayName: "\u041C\u0438\u0441\u0430\u043A\u0438"
  role: "\u041E\u0444\u0438\u0441\u043D\u044B\u0439 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A"
  shirtColor: {r: 0.92, g: 0.92, b: 0.95, a: 1}
  pantsColor: {r: 0.12, g: 0.12, b: 0.15, a: 1}
  hairColor: {r: 0.12, g: 0.08, b: 0.05, a: 1}
  skinColor: {r: 0.95, g: 0.8, b: 0.68, a: 1}
  walkSpeed: 1.4
  dialogues:
  - lines:
    - "\u0423\u0444, \u0435\u0449\u0451 \u043E\u0434\u043D\u0430 \u0441\u043C\u0435\u043D\u0430
      \u0432\u0432\u043E\u0434\u0430 \u0434\u0430\u043D\u043D\u044B\u0445... \u041F\u043B\u0430\u0442\u044F\u0442
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E."
    - "\u0422\u0435\u0440\u043C\u0438\u043D\u0430\u043B \u0434\u043B\u044F \u043F\u043E\u0434\u0440\u0430\u0431\u043E\u0442\u043A\u0438
      \u2014 \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u0436\u0435
      \u043D\u0430\u0448\u0435\u0433\u043E \u043E\u0444\u0438\u0441\u0430. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u0434\u043E\u0439\u0434\u0438 \u043A \u0441\u0442\u043E\u043B\u0443."
  - lines:
    - "\u0418\u043D\u043E\u0433\u0434\u0430 \u0434\u0443\u043C\u0430\u044E: \u043C\u043E\u0436\u0435\u0442,
      \u0442\u043E\u0436\u0435 \u0441\u0442\u0430\u0442\u044C \u043F\u0440\u043E\u0444\u0438
      \u0432 GGO? \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043B\u0443\u0447\u0448\u0438\u0435
      \u0438\u0433\u0440\u043E\u043A\u0438 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442
      \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u0435\u043D\u044C\u0433\u0438."
